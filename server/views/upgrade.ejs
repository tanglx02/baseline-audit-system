<%- include('_head', {title:'系统升级 - 安全基线核查系统'}) %>
<%- include('_nav', {active:'upgrade'}) %>
<main class="container">
  <h1>系统升级</h1>
  <div class="alert-info">
    当前版本：<b>v<%= current.version %></b><% if (current.releasedAt) { %>（发布于 <%= current.releasedAt %>）<% } %>。
    升级前系统会自动备份当前源码到 <code>backups/</code> 目录，可随时回滚。
  </div>

  <!-- 在线升级 -->
  <div class="panel">
    <h2>在线升级（Git）</h2>
    <% if (!gitAvailable) { %>
      <div class="msg err">服务器未安装 git，无法使用在线升级。请改用下方「离线升级」。</div>
    <% } %>
    <label>Git 远程仓库地址</label>
    <input id="gitRemote" value="<%= cfg.upgrade.gitRemote %>" placeholder="例如 https://github.com/your/repo.git" />
    <label>跟踪分支</label>
    <input id="gitBranch" value="<%= cfg.upgrade.gitBranch %>" placeholder="main" />
    <button class="btn btn-sm" onclick="saveRemote()">保存仓库配置</button>
    <span id="remoteMsg" class="msg" style="display:inline-block;margin-left:8px"></span>
    <hr style="margin:16px 0;border:none;border-top:1px solid var(--line)" />
    <button class="btn btn-primary" onclick="checkOnline()">检查更新</button>
    <div id="onlineMsg" class="msg" style="margin-top:12px"></div>
  </div>

  <!-- 离线升级 -->
  <div class="panel">
    <h2>离线升级（上传源码压缩包）</h2>
    <p class="muted">上传一个包含新版源码的 <code>.zip</code>（根目录需有 <code>version.json</code>）。系统会比对版本号，仅当比当前更新时才应用。</p>
    <input id="pkg" type="file" accept=".zip" />
    <button class="btn btn-primary" onclick="applyOffline()">上传并更新</button>
    <div id="offlineMsg" class="msg" style="margin-top:12px"></div>
  </div>

  <div class="panel">
    <h2>升级设置</h2>
    <label><input type="checkbox" id="autoRestart" <%= cfg.upgrade.autoRestart ? 'checked' : '' %> /> 应用更新后自动重启服务</label>
    <button class="btn btn-sm" onclick="saveSettings()">保存设置</button>
  </div>
</main>

<script>
async function saveRemote(){
  const remote=document.getElementById('gitRemote').value.trim();
  const branch=document.getElementById('gitBranch').value.trim()||'main';
  const r=await fetch('/settings',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({gitRemote:remote,gitBranch:branch})});
  const d=await r.json();
  const m=document.getElementById('remoteMsg');
  m.className='msg ok'; m.textContent= d.ok?'已保存':'保存失败';
}
async function saveSettings(){
  const autoRestart=document.getElementById('autoRestart').checked;
  await fetch('/settings',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({autoRestart})});
  const m=document.getElementById('remoteMsg'); m.className='msg ok'; m.textContent='设置已保存';
}
async function checkOnline(){
  const m=document.getElementById('onlineMsg'); m.className='msg'; m.textContent='检查中…';
  try{
    const r=await fetch('/api/upgrade/check',{method:'POST'});
    const d=await r.json();
    if(!d.available){ m.className='msg err'; m.textContent= d.message||'无法检查更新'; return; }
    if(d.hasUpdate){
      m.className='msg ok';
      m.innerHTML=`发现新版本 <b>v${d.latest}</b>（当前 v${d.current}）。<button class="btn btn-sm" onclick="doOnline()">立即更新</button>`;
    } else {
      m.className='msg'; m.textContent=`已是最新版本（v${d.current}）。`;
    }
  }catch(e){ m.className='msg err'; m.textContent='检查失败：'+e.message; }
}
async function doOnline(){
  const m=document.getElementById('onlineMsg'); m.className='msg'; m.textContent='正在更新并重启…';
  try{
    const r=await fetch('/api/upgrade/online',{method:'POST'});
    const d=await r.json();
    if(d.ok){ m.className='msg ok'; m.textContent='更新成功，服务重启中，请刷新页面。'; setTimeout(()=>location.reload(),3000); }
    else { m.className='msg err'; m.textContent='更新失败：'+(d.message||d.error); }
  }catch(e){ m.className='msg err'; m.textContent='更新失败：'+e.message; }
}
async function applyOffline(){
  const file=document.getElementById('pkg').files[0];
  const m=document.getElementById('offlineMsg');
  if(!file){ m.className='msg err'; m.textContent='请先选择压缩包'; return; }
  m.className='msg'; m.textContent='上传并检查中…';
  const fd=new FormData(); fd.append('package',file);
  try{
    const r=await fetch('/api/upgrade/offline',{method:'POST',body:fd});
    const d=await r.json();
    if(d.ok){ m.className='msg ok'; m.textContent='更新成功（备份：'+d.backup+'），服务重启中，请刷新。'; setTimeout(()=>location.reload(),3000); }
    else if(d.error==='ALREADY_LATEST'){ m.className='msg'; m.textContent='已是最新版本，无需更新。'; }
    else if(d.error==='OLDER'){ m.className='msg err'; m.textContent='上传版本（v'+d.latest+'）比当前（v'+d.current+'）更旧，已拒绝。'; }
    else { m.className='msg err'; m.textContent='更新失败：'+(d.message||d.error); }
  }catch(e){ m.className='msg err'; m.textContent='更新失败：'+e.message; }
}
</script>
<%- include('_foot') %>
