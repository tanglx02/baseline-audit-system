<%- include('_head', {title:'系统升级 - 安全基线核查系统'}) %>
<%- include('_nav', {active:'upgrade'}) %>
<main class="container">
  <h1>系统升级</h1>
  <div class="alert-info">
    当前版本：<b>v<%= current.version %></b><% if (current.releasedAt) { %>（发布于 <%= current.releasedAt %>）<% } %>。
    升级前系统会自动备份当前源码到 <code>backups/</code> 目录，可随时回滚。
  </div>

  <!-- 在线升级 -->
  <div class="panel">
    <h2>在线升级</h2>
    <% if (!gitAvailable) { %>
      <div class="msg err">服务器未安装 git，无法使用在线升级。请改用下方「离线升级」。</div>
    <% } else { %>
      <p class="muted">选择升级源，系统将自动检查并拉取最新版本（无需手动填写仓库地址）：</p>
      <div class="source-grid">
        <% sources.forEach(function(s){ %>
          <div class="source-card">
            <div class="source-name"><%= s.label %></div>
            <div class="source-url"><%= s.url %></div>
            <button class="btn btn-primary" onclick="checkOnline('<%= s.key %>')">从 <%= s.label %> 获取升级</button>
            <div id="msg-<%= s.key %>" class="msg" style="margin-top:10px"></div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>

  <!-- 离线升级 -->
  <div class="panel">
    <h2>离线升级（上传源码压缩包）</h2>
    <p class="muted">上传一个包含新版源码的 <code>.zip</code>（根目录需有 <code>version.json</code>）。系统会比对版本号，仅当比当前更新时才应用。</p>
    <input id="pkg" type="file" accept=".zip" />
    <button class="btn btn-primary" onclick="applyOffline()">上传并更新</button>
    <div id="offlineMsg" class="msg" style="margin-top:12px"></div>
  </div>

  <div class="panel">
    <h2>升级设置</h2>
    <p class="muted">更多设置（如自动重启）请到 <a href="/settings">系统设置</a> 页配置。</p>
  </div>
</main>

<script>
async function checkOnline(source){
  const m=document.getElementById('msg-'+source); m.className='msg'; m.textContent='检查中…';
  try{
    const r=await fetch('/api/upgrade/check',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({source})});
    const d=await r.json();
    if(!d.available){ m.className='msg err'; m.textContent= d.message||'无法检查更新'; return; }
    if(d.hasUpdate){
      m.className='msg ok';
      m.innerHTML=`发现新版本 <b>v${d.latest}</b>（当前 v${d.current}）。<button class="btn btn-sm" onclick="doOnline('${source}')">立即更新</button>`;
    } else {
      m.className='msg'; m.textContent=`已是最新版本（v${d.current}）。`;
    }
  }catch(e){ m.className='msg err'; m.textContent='检查失败：'+e.message; }
}
async function doOnline(source){
  const m=document.getElementById('msg-'+source); m.className='msg'; m.textContent='正在更新并重启…';
  try{
    const r=await fetch('/api/upgrade/online',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({source})});
    const d=await r.json();
    if(d.ok){ m.className='msg ok'; m.textContent='更新成功，服务重启中，请刷新页面。'; setTimeout(()=>location.reload(),3000); }
    else { m.className='msg err'; m.textContent='更新失败：'+(d.message||d.error); }
  }catch(e){ m.className='msg err'; m.textContent='更新失败：'+e.message; }
}
async function applyOffline(){
  const file=document.getElementById('pkg').files[0];
  const m=document.getElementById('offlineMsg');
  if(!file){ m.className='msg err'; m.textContent='请先选择压缩包'; return; }
  m.className='msg'; m.textContent='上传并检查中…';
  const fd=new FormData(); fd.append('package',file);
  try{
    const r=await fetch('/api/upgrade/offline',{method:'POST',body:fd});
    const d=await r.json();
    if(d.ok){ m.className='msg ok'; m.textContent='更新成功（备份：'+d.backup+'），服务重启中，请刷新。'; setTimeout(()=>location.reload(),3000); }
    else if(d.error==='ALREADY_LATEST'){ m.className='msg'; m.textContent='已是最新版本，无需更新。'; }
    else if(d.error==='OLDER'){ m.className='msg err'; m.textContent='上传版本（v'+d.latest+'）比当前（v'+d.current+'）更旧，已拒绝。'; }
    else { m.className='msg err'; m.textContent='更新失败：'+(d.message||d.error); }
  }catch(e){ m.className='msg err'; m.textContent='更新失败：'+e.message; }
}
</script>
<%- include('_foot') %>
