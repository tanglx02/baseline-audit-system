<%- include('_head', {title:'系统设置 - 安全基线核查系统'}) %>
<%- include('_nav', {active:'upgrade'}) %>
<main class="container">
  <h1>系统设置</h1>
  <div class="panel">
    <h2>升级设置</h2>
    <label><input type="checkbox" id="autoRestart" <%= cfg.upgrade.autoRestart ? 'checked' : '' %> /> 应用更新后自动重启服务</label>
    <button class="btn btn-primary" onclick="save()">保存</button>
    <span id="msg" class="msg" style="display:inline-block;margin-left:8px"></span>
    <p class="muted" style="margin-top:12px">
      在线升级的仓库地址为系统内置固定值（<a href="https://github.com/tanglx02/baseline-audit-system" target="_blank" rel="noopener">GitHub</a> /
      <a href="https://gitee.com/tanglx02/baseline-audit-system" target="_blank" rel="noopener">Gitee</a>），
      在 <a href="/upgrade">升级页</a> 直接选择「从 GitHub / Gitee 获取升级」即可，无需在此填写。
    </p>
  </div>
</main>
<script>
async function save(){
  const autoRestart=document.getElementById('autoRestart').checked;
  const r=await fetch('/settings',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({autoRestart})});
  const d=await r.json();
  const m=document.getElementById('msg'); m.className='msg ok'; m.textContent= d.ok?'已保存':'保存失败';
}
</script>
<%- include('_foot') %>
