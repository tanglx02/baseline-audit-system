<%- include('_head', {title:'授权状态 - 安全基线核查系统'}) %>
<%- include('_nav', {active:'license'}) %>
<main class="container">
  <h1>授权状态</h1>
  <div class="alert-info">
    本系统支持两种激活方式：<br>
    <b>① 卡密激活（推荐）</b>：直接把卡密整段粘贴到下方框中激活，无需登录服务器改文件。卡密不绑定机器，换机/重装后用同一卡密重新激活即可（注意：卡密为<b>一次性</b>，激活后立即失效）。<br>
    <b>② 机器码离线授权</b>：复制下方「本机机器码」发给作者，作者用「授权后台软件」生成对应许可证字符串后回贴到下方框中激活。该许可证<b>绑定本机机器码</b>，换机需重新申请。<br>
    若还没有卡密或许可证，请<b>联系作者 QQ：54312795</b> 获取。
  </div>

  <div class="panel">
    <h2>当前状态</h2>
    <p>授权状态：
      <% if (status.valid) { %>
        <span class="badge ok">已授权</span>
        <% if (status.mode === 'card') { %><span class="badge">卡密激活</span><% } else { %><span class="badge">机器码许可证</span><% } %>
        有效期至 <b><%= status.payload.exp || '永久' %></b>
        <% if (status.daysLeft != null) { %>，剩余 <b><%= status.daysLeft %></b> 天<% } %>，
        功能：<%= (status.payload.feat||[]).join(', ') %>
      <% } else { %>
        <span class="badge bad">未授权（<%= status.reason %>）</span>
      <% } %>
    </p>
    <p class="muted">本机机器码（用于「机器码离线授权」；卡密激活不绑定机器码）：<code class="mono"><%= machineCode %></code>
      <button class="btn btn-sm" onclick="copyMc()">复制机器码</button>
    </p>
  </div>

  <div class="panel">
    <h2><%= status.valid ? '更换 / 重新激活' : '激活' %>（卡密 或 机器码许可证）</h2>
    <p class="muted">把<b>卡密</b>或<b>机器码许可证字符串</b>整段粘贴到下方，点击「激活」立即生效（无需重启）。系统会自动识别类型并完成激活。</p>
    <textarea id="licInput" class="lic-input" rows="4" placeholder="请输入卡密或机器码许可证，例如：eyJ..._.xxxx"></textarea>
    <div class="row">
      <button id="btn-activate" class="btn btn-primary" onclick="activate()">激活</button>
      <% if (status.valid) { %>
        <button id="btn-deactivate" class="btn btn-danger" onclick="deactivate()">吊销当前授权</button>
      <% } %>
    </div>
    <div id="licMsg" class="msg"></div>
  </div>

  <div class="panel contact-author">
    <h2>获取卡密 / 许可证</h2>
    <p>本系统需有效授权才能使用全部功能。如尚未获取，请<b>联系作者 QQ：54312795</b> 申请：<br>
      • <b>卡密</b>（推荐，不绑机器，一次性使用）；<br>
      • <b>机器码许可证</b>（绑定本机，把上方机器码发给作者即可签发）。</p>
    <p class="muted">两者均采用 <code>HMAC-SHA256</code> 离线签名校验，含有效期。作者使用「授权后台软件」(<code>LicenseConsole.exe</code>) 同时签发卡密与机器码许可证。</p>
  </div>

  <div class="panel">
    <h2>授权后台软件（LicenseConsole.exe）</h2>
    <p class="muted">作者可在 Windows 上使用独立的「授权后台软件」<code>LicenseConsole.exe</code>，集成两种签发方式：<b>卡密生成</b>与<b>机器码许可证签发</b>，算法与本站完全一致，签发结果可直接在网页激活。</p>
  </div>
</main>

<script>
function copyMc(){
  var t=document.querySelector('code.mono'); if(!t) return;
  navigator.clipboard.writeText(t.textContent).then(function(){},function(){});
}
function reasonText(r){
  return ({
    NO_LICENSE:'无授权', MALFORMED:'格式错误', BAD_PAYLOAD:'内容解析失败',
    BAD_SIGNATURE:'签名校验失败（可能被篡改或不是本系统签发）', EXPIRED:'已过期',
    MACHINE_MISMATCH:'机器码不匹配（该许可证不是为本机签发，请用本机机器码申请）',
    ALREADY_USED:'该卡密已被使用（卡密为一次性，不可重复激活）',
    NOT_CARD:'该许可证不是卡密类型'
  })[r] || r;
}
async function activate(){
  const ta=document.getElementById('licInput');
  const out=document.getElementById('licMsg');
  const lic=ta.value.trim();
  if(!lic){ out.className='msg err'; out.textContent='请粘贴卡密或机器码许可证'; return; }
  out.className='msg'; out.textContent='处理中…';
  try{
    const r=await fetch('/license/activate',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({license:lic})});
    const d=await r.json();
    if(d.valid){
      out.className='msg ok';
      var mode = d.mode==='card' ? '卡密激活' : '机器码许可证激活';
      out.textContent=mode+'成功！'+(d.payload.exp?('有效期至 '+d.payload.exp+'，剩余 '+d.daysLeft+' 天'):'永久有效')+'。正在刷新…';
      setTimeout(()=>location.reload(),1200);
    } else {
      out.className='msg err';
      out.textContent='激活失败：'+reasonText(d.reason);
    }
  }catch(e){ out.className='msg err'; out.textContent='请求失败：'+e.message; }
}
async function deactivate(){
  if(!confirm('确认吊销当前授权？吊销后系统将回到未授权状态。')) return;
  const out=document.getElementById('licMsg');
  try{
    await fetch('/license/deactivate',{method:'POST'});
    out.className='msg'; out.textContent='已吊销，正在刷新…';
    setTimeout(()=>location.reload(),800);
  }catch(e){ out.className='msg err'; out.textContent='吊销失败：'+e.message; }
}
</script>
<%- include('_foot') %>
