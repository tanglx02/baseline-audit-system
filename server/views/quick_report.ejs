<%- include('_head', {title:'快速报告 - 安全基线核查系统'}) %>
<%- include('_nav', {active:'quick-report'}) %>
<main class="container">
  <h1>快速报告生成</h1>
  <p class="muted">没时间上传脚本跑？直接选择基线模块、填写目标 IP、指定每个模块「合格 / 不合格」，一键生成最终 HTML 报告。报告基于真实基线检查项构造，格式与正常扫描报告一致。</p>
  <p class="hint warn">提示：快速报告未按实际执行核查脚本，仅按您指定的合格/不合格状态填充。用于演示或预检时请如实标注。</p>

  <div class="panel">
    <h2>1. 目标信息</h2>
    <div class="form-grid">
      <label class="field">
        <span>目标 IP <em class="req">*</em></span>
        <input type="text" id="ip" placeholder="例如 192.168.1.10" required>
      </label>
      <label class="field">
        <span>主机名（可选）</span>
        <input type="text" id="hostname" placeholder="留空则使用 IP 作为主机名">
      </label>
      <label class="field">
        <span>报告标题（可选）</span>
        <input type="text" id="title" placeholder="如：2026年第一季度基线核查">
      </label>
    </div>
  </div>

  <div class="panel">
    <h2>2. 选择基线模块并指定结论</h2>
    <p class="muted">勾选要纳入报告的模块；每个模块选择「合格」（全部检查项合规）或「不合格」（全部检查项不合规）。</p>
    <div id="modList" class="mod-list">
      <% modules.forEach(function(m){ %>
      <div class="mod-card" data-id="<%= m.id %>">
        <div class="mod-head">
          <label class="mod-pick">
            <input type="checkbox" class="mod-check" checked>
            <span class="mod-name"><%= m.label %></span>
          </label>
          <span class="tag"><%= m.platform %></span>
          <span class="tag"><%= m.item_count %> 项</span>
        </div>
        <div class="mod-cats">
          <% Object.keys(m.categories).forEach(function(cat){ %>
            <span class="chip"><%= cat %> ×<%= m.categories[cat] %></span>
          <% }); %>
        </div>
        <div class="mod-status">
          <label><input type="radio" name="st_<%= m.id %>" value="pass" checked> 合格</label>
          <label><input type="radio" name="st_<%= m.id %>" value="fail"> 不合格</label>
        </div>
      </div>
      <% }); %>
    </div>
  </div>

  <div class="panel">
    <h2>3. 生成报告</h2>
    <button class="btn btn-primary" id="genBtn" type="button">生成并下载 HTML 报告</button>
    <div id="genOut" class="outbox"></div>
  </div>
</main>
<script>
document.getElementById('genBtn').addEventListener('click', async function(){
  var ip = document.getElementById('ip').value.trim();
  if(!ip){ alert('请填写目标 IP'); return; }
  var hostname = document.getElementById('hostname').value.trim();
  var title = document.getElementById('title').value.trim();
  var modules = [];
  document.querySelectorAll('#modList .mod-card').forEach(function(card){
    var chk = card.querySelector('.mod-check');
    if(!chk.checked) return;
    var id = card.getAttribute('data-id');
    var st = card.querySelector('input[name="st_'+id+'"]:checked');
    modules.push({ catalogId: id, status: st ? st.value : 'pass' });
  });
  if(modules.length === 0){ alert('请至少勾选一个基线模块'); return; }
  var out = document.getElementById('genOut');
  out.innerHTML = '<span class="badge">生成中…</span>';
  try{
    var r = await fetch('/api/quick-report/generate', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ ip: ip, hostname: hostname, title: title, modules: modules })
    });
    if(!r.ok){
      var j = await r.json().catch(function(){ return {error: r.status + ' ' + r.statusText}; });
      out.innerHTML = '<span class="badge bad">失败：' + (j.error || r.status) + '</span>';
      return;
    }
    var blob = await r.blob();
    var fn = 'quick_report_' + ip + '_' + new Date().toISOString().slice(0,10) + '.html';
    var u = URL.createObjectURL(blob);
    var a = document.createElement('a'); a.href = u; a.download = fn; document.body.appendChild(a); a.click(); a.remove();
    URL.revokeObjectURL(u);
    out.innerHTML = '<span class="badge ok">已生成并下载：' + fn + '</span>';
  }catch(err){
    out.innerHTML = '<span class="badge bad">错误：' + err.message + '</span>';
  }
});
</script>
<%- include('_foot') %>
