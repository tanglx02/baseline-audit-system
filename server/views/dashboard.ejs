<%- include('_head', {title:'概览 - 安全基线核查系统'}) %>
<%- include('_nav', {active:'dashboard'}) %>
<main class="container">
  <h1>概览</h1>
  <div class="cards">
    <div class="card"><div class="n"><%= stats.servers %></div><div class="l">服务器</div></div>
    <div class="card"><div class="n"><%= stats.scans %></div><div class="l">扫描次数</div></div>
    <div class="card"><div class="n"><%= stats.findings.total %></div><div class="l">核查项</div></div>
    <div class="card"><div class="n" style="color:#1a7f37"><%= stats.findings.pass %></div><div class="l">合规</div></div>
    <div class="card"><div class="n" style="color:#c0341d"><%= stats.findings.fail %></div><div class="l">不合规</div></div>
    <div class="card"><div class="n" style="color:#9a6700"><%= stats.findings.manual %></div><div class="l">待人工</div></div>
    <div class="card"><div class="n"><%= stats.compliance==null?'—':(stats.compliance*100).toFixed(1)+'%' %></div><div class="l">总体合规率</div></div>
  </div>

  <div class="dash-cols">
    <div class="panel">
      <h2>平台分布</h2>
      <div class="plat-rows">
        <% Object.keys(platforms||{}).forEach(function(p){ %>
          <div class="plat-row"><span class="plat-name"><%= p %></span><span class="plat-bar"><span style="width:<%= (platforms[p]/stats.servers*100)||0 %>%"></span></span><span class="plat-num"><%= platforms[p] %></span></div>
        <% }); %>
        <% if (!platforms || !Object.keys(platforms).length) { %><p class="muted">暂无数据</p><% } %>
      </div>
      <% if (tags && tags.length) { %>
      <h2 style="margin-top:14px">标签</h2>
      <div class="tag-filter">
        <% tags.forEach(function(t){ %><a class="chip" href="/servers?tag=<%= encodeURIComponent(t) %>"><%= t %></a><% }); %>
      </div>
      <% } %>
    </div>

    <div class="panel">
      <h2>不合规 TOP 设备</h2>
      <% if (!topDevices || !topDevices.length) { %>
        <p class="muted">暂无设备数据。</p>
      <% } else { %>
      <table class="mini">
        <thead><tr><th>主机</th><th>平台</th><th>合规率</th><th>不合规</th></tr></thead>
        <tbody>
        <% topDevices.forEach(function(d){ %>
          <tr>
            <td><a href="/servers/<%= d.server_id %>"><%= d.hostname %></a></td>
            <td><span class="badge-plat <%= d.platform %>"><%= d.platform %></span></td>
            <td><b style="color:<%= (d.compliance!=null && d.compliance>=0.9)?'#1a7f37':(d.compliance>=0.7?'#2f6fed':'#c0341d') %>"><%= d.compliance!=null?(d.compliance*100).toFixed(1)+'%':'—' %></b></td>
            <td><span class="badge bad"><%= d.fail %></span></td>
          </tr>
        <% }); %>
        </tbody>
      </table>
      <% } %>
    </div>
  </div>

  <h2>已接入服务器</h2>
  <% if (servers.length === 0) { %>
    <p class="muted">尚未上传任何基线报告。<a href="/upload">上传一份采集结果</a> 或 <a href="/download">下载采集脚本</a>。</p>
  <% } else { %>
    <table>
      <thead><tr><th>主机名</th><th>平台</th><th>系统</th><th>扫描数</th><th>最近扫描</th><th></th></tr></thead>
      <tbody>
      <% servers.forEach(function(s){ %>
        <tr>
          <td><b><%= s.hostname %></b></td>
          <td><span class="badge-plat <%= s.platform %>"><%= s.platform %></span></td>
          <td><%= s.os %> <%= s.os_version||'' %></td>
          <td><%= s.scan_count %></td>
          <td><%= s.last_scan?s.last_scan.replace('T',' ').slice(0,19):'—' %></td>
          <td><a class="btn btn-sm" href="/servers/<%= s.id %>">查看报告</a></td>
        </tr>
      <% }); %>
      </tbody>
    </table>
  <% } %>
</main>
<%- include('_foot') %>
